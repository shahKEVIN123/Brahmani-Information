# ========================================================
# BRAHMANI INFORMATION — BACKEND SMTP CONFIGURATION
# ========================================================
# Configure your SMTP credentials below to enable live email delivery.
# Never commit actual passwords or .env files to version control.

# SMTP Server Host (e.g. smtp.gmail.com)
SMTP_HOST=

# SMTP Server Port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP Secure Flag (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Authenticated User (e.g. info@brahmaniinformation.com)
SMTP_USER=

# SMTP Password (16-character App Password generated for the email account)
SMTP_PASS=

# Sender Display Name and Email Address
SMTP_FROM=

# Recipient Addresses (Defaults already set in code)
EMAIL_TO=info@brahmaniinformation.com
EMAIL_CC=shahkevin1911@gmail.com

# Standalone Express Server Port (Default: 5000)
PORT=5000
