# ========================================================
# BRAHMANI INFORMATION — BACKEND SMTP CONFIGURATION
# ========================================================
# Configure your SMTP credentials below to enable live email delivery.
# Never commit your production passwords to version control.

# SMTP Server Host (e.g. smtp.gmail.com, smtp.hostinger.com, smtp.office365.com, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for STARTTLS or 465 for SSL/TLS)
SMTP_PORT=587

# SMTP Secure Flag (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Authenticated User (Your email address or SMTP username)
SMTP_USER=info@brahmaniinformation.com

# SMTP Password (App Password for Gmail/Google Workspace, or your mailbox password)
SMTP_PASS=your-app-password-or-smtp-password

# Optional Sender Display Name
SMTP_FROM="Brahmani Information" <info@brahmaniinformation.com>

# Required Email Recipients (Defaults already configured in code)
EMAIL_TO=info@brahmaniinformation.com
EMAIL_CC=shahkevin1911@gmail.com

# Standalone Server Port (Default: 5000)
PORT=5000

